# Names only — real values go in .env (git-ignored)
AGNTCY_IDENTITY_API_KEY=
AGNTCY_ORG_API_KEY=
LLM_API_KEY=
# AGNTCY Identity Node (agntcy-identity-sdk); USE_SSL=0 only for a local node
IDENTITY_NODE_GRPC_SERVER_URL=
IDENTITY_NODE_USE_SSL=
# Token broker key shared by the gateway and the (lab) intake: hex, >= 64 chars
AGENTTRUSTSEC_BROKER_KEY=
# P4d LLM intent verifier (Claude) — or use `ant auth login`; never commit a key
ANTHROPIC_API_KEY=
